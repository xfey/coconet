[Unit]
Description=Coconet Project Authority Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coconet
Group=coconet
EnvironmentFile=-/etc/coconet/server.env
ExecStart=/usr/local/bin/coconet-server serve --config /var/lib/coconet/server.json
Restart=on-failure
RestartSec=5s
LogNamespace=coconet
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/coconet
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
