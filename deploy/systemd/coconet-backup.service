[Unit]
Description=Coconet online metadata backup and restore verification
After=coconet-server.service

[Service]
Type=oneshot
User=coconet
Group=coconet
ExecStart=/usr/bin/python3 /usr/local/lib/coconet/backup.py --config /etc/coconet/backup.json
UMask=0077
LogNamespace=coconet
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/coconet/backups
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=8min
MemoryMax=512M
CPUQuota=50%
Nice=19
IOSchedulingClass=idle
