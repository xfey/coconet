# The default filesystem + bbolt deployment needs no environment
# secrets. Copy this file to /etc/coconet/server.env only when an option below
# is needed, then set root:root 0600.

# Trust forwarding headers only from exact reverse-proxy networks controlled by
# the operator. Never use 0.0.0.0/0 or ::/0. This example fits same-host Nginx.
# COCONET_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Only enable these after `coconet-server init --artifact-store s3`.
# COCONET_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# COCONET_S3_REGION=auto
# COCONET_S3_BUCKET=coconet-session-artifacts
# COCONET_S3_ACCESS_KEY=
# COCONET_S3_SECRET_KEY=

# Only set this when server.json uses "metadata_driver": "postgres".
# COCONET_DATABASE_URL=postgres://user:password@host/database

# Relay content is stored locally in <data_path>.relay by default.
# With PostgreSQL authority storage, set an explicit absolute Relay directory.
# Current Relay content does not use the legacy S3 artifact backend.
# COCONET_RELAY_HOME=/var/lib/coconet/relay
# Models run on user devices; no server inference credentials are needed.

# Account login. Default key mode requires a local operator-created account;
# there is no public Git-profile signup endpoint.
# COCONET_AUTH_PROVIDER=github
# COCONET_AUTH_CLIENT_ID=
# COCONET_AUTH_CLIENT_SECRET=
# OIDC deployments use provider=oidc plus the HTTPS issuer and optional label.
# COCONET_AUTH_ISSUER=https://identity.example.com
# COCONET_AUTH_LABEL=Company SSO
# Optional separate HTTPS browser origin; defaults to advertised_endpoint.
# COCONET_WEB_ORIGIN=https://coconet.example.com
# Register <web_origin>/v1/auth/callback at the identity provider.

# Development Relay v2 direct transfers (separate from legacy artifact storage).
# Cloudflare R2 was validated with the isolated coconet-relay-v2/ prefix.
# The same private bucket can be reused; legacy COCONET_S3_* is not auto-inherited.
# COCONET_RELAY_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# COCONET_RELAY_S3_REGION=auto
# COCONET_RELAY_S3_BUCKET=coconet-session-artifacts
# COCONET_RELAY_S3_ACCESS_KEY=
# COCONET_RELAY_S3_SECRET_KEY=
# Other S3-compatible providers require their own real-provider acceptance.
# Do not switch an initialized Relay directory to a different backend.
# Do not apply age-based bucket expiration to the Relay prefix: content renews
# without changing its creation time. App maintenance owns temporary expiry.

# Temporary Relay objects: default 168h, minimum nonzero 1h; 0 disables final expiry.
# Only applies when COCONET_RELAY_S3_ENDPOINT is configured.
# COCONET_RELAY_CONTENT_TTL=168h
# Conservative total reservation for staging + final bytes (default 100 GiB).
# COCONET_RELAY_TRANSFER_BYTES=107374182400

# Shared admission budget for authority + Relay metadata files (default 4 GiB).
# Each write keeps an additional 64 MiB transaction/COW growth margin.
# COCONET_METADATA_BYTES=4294967296
# Minimum unprivileged filesystem free space (default 2 GiB; Hosted uses 5 GiB).
# COCONET_MIN_FREE_BYTES=5368709120

# Compact checkpoint-covered commit bodies after 7 days; 0 disables collection.
# Requires clients with checkpoint catch-up and durable receipt recovery.
# COCONET_RELAY_HISTORY_RETENTION=168h

# Private local operator socket for storage metrics and online R2 metadata backup.
# Must be inside the private directory containing server.db; omitted = disabled.
# COCONET_OPERATOR_SOCKET=/var/lib/coconet/operator.sock

# Default logs omit successful polling/transfers and expected Relay waits.
# Temporarily enable all structured request events while diagnosing a failure.
# COCONET_LOG_REQUESTS=all
