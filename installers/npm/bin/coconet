#!/bin/sh

# Keep the npm command stable while the native Runtime remains versioned under
# the user's Coconet data root. Node is used only when setup or an upgrade is
# required; successful daily commands replace this process with the Runtime.
# Installing a newer npm package selects an update for the next invocation.
# Bootstrap coordinates running work before activating its pinned Runtime.

launcher=$0
link_depth=0
while [ -L "$launcher" ]; do
  link_depth=$((link_depth + 1))
  if [ "$link_depth" -gt 16 ]; then
    printf '%s\n' "coconet: the npm launcher contains too many symbolic links" >&2
    exit 1
  fi
  launcher_directory=$(CDPATH= cd -P "$(dirname "$launcher")" 2>/dev/null && pwd) || {
    printf '%s\n' "coconet: could not resolve the npm launcher directory" >&2
    exit 1
  }
  link_target=$(readlink "$launcher") || {
    printf '%s\n' "coconet: could not resolve the npm launcher link" >&2
    exit 1
  }
  case $link_target in
    /*) launcher=$link_target ;;
    *) launcher=$launcher_directory/$link_target ;;
  esac
done

launcher_directory=$(CDPATH= cd -P "$(dirname "$launcher")" 2>/dev/null && pwd) || {
  printf '%s\n' "coconet: could not resolve the npm package directory" >&2
  exit 1
}
package_root=$(dirname "$launcher_directory")
package_json=$package_root/package.json
setup_command=$package_root/cli.mjs

if [ ! -f "$package_json" ] || [ ! -x "$setup_command" ]; then
  printf '%s\n' "coconet: the npm installation is incomplete; reinstall the global coconet package" >&2
  exit 1
fi

package_version=$(LC_ALL=C sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$package_json" | LC_ALL=C sed -n '1p')
if [ -z "$package_version" ]; then
  printf '%s\n' "coconet: could not read the npm package version" >&2
  exit 1
fi

if [ -n "${XDG_DATA_HOME:-}" ]; then
  data_root=$XDG_DATA_HOME
elif [ -n "${HOME:-}" ]; then
  data_root=$HOME/.local/share
else
  printf '%s\n' "coconet: HOME or XDG_DATA_HOME is required" >&2
  exit 1
fi

install_root=$data_root/coconet
runtime=$install_root/current/bin/coconet
runtime_manifest=$install_root/current/manifest.json

runtime_version() {
  if [ ! -f "$runtime_manifest" ]; then
    return 1
  fi
  LC_ALL=C sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$runtime_manifest" | LC_ALL=C sed -n '1p'
}

setup_runtime() {
  # Setup never reads the original command's stdin (notably MCP messages).
  # Forward signals even when a caller terminates only this launcher PID.
  "$setup_command" --if-newer </dev/null >&2 &
  setup_pid=$!
  trap 'kill -INT "$setup_pid" 2>/dev/null; wait "$setup_pid"; exit 130' INT
  trap 'kill -TERM "$setup_pid" 2>/dev/null; wait "$setup_pid"; exit 143' TERM
  wait "$setup_pid"
  setup_result=$?
  trap - INT TERM
  return "$setup_result"
}

installed_version=$(runtime_version 2>/dev/null || true)
COCONET_NPM_PACKAGE_ROOT=$package_root
export COCONET_NPM_PACKAGE_ROOT
if [ -x "$runtime" ] && [ -n "$installed_version" ]; then
  if [ "$#" -eq 1 ] && [ "$1" = "update" ]; then
    if "$runtime" update --help >/dev/null 2>&1; then
      exec "$runtime" "$@"
    fi
    # The old Runtime has no updater. Installing the npm-selected version
    # completes this explicit update; do not download it a second time.
    setup_runtime
    exit "$?"
  fi
  if [ "$installed_version" != "$package_version" ] &&
    [ "$(node "$package_root/compare-version.mjs" "$package_version" "$installed_version")" = "1" ]; then
    printf 'coconet: Updating Coconet %s -> %s before running your command...\n' "$installed_version" "$package_version" >&2
    setup_runtime
    setup_status=$?
    case $setup_status in
      0) ;;
      130|143) exit "$setup_status" ;;
      *) printf '%s\n' 'coconet: Update did not complete; continuing with the installed Runtime. The next launch will retry.' >&2 ;;
    esac
  fi
  exec "$runtime" "$@"
fi

printf 'coconet: Installing Coconet %s before running your command...\n' "$package_version" >&2

# Setup is incidental to the requested command, including JSON and MCP
# commands. Its human-readable result must not enter that command's stdout.
setup_runtime
setup_status=$?
if [ "$setup_status" -ne 0 ]; then
  printf '%s\n' "coconet: Setup did not complete; your command was not run." >&2
  exit "$setup_status"
fi

installed_version=$(runtime_version 2>/dev/null || true)
if [ ! -x "$runtime" ] || [ -z "$installed_version" ] ||
  { [ "$installed_version" != "$package_version" ] &&
    [ "$(node "$package_root/compare-version.mjs" "$installed_version" "$package_version")" != "1" ]; }; then
  printf '%s\n' "coconet: setup finished without activating the expected Runtime" >&2
  exit 1
fi

# Bootstrap already configured default and registered Agent integrations.
exec "$runtime" "$@"
