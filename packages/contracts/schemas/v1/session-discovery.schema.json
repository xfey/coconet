{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.coddis.dev/v1/session-discovery.schema.json",
  "title": "Coconet local Session discovery",
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "agent_type", "native_session_id", "cwd", "activity_state", "updated_at"],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
        "agent_type": { "$ref": "common.schema.json#/$defs/agent_type" },
        "native_session_id": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "activity_state": { "$ref": "common.schema.json#/$defs/activity_state" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sessions"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    }
  }
}
