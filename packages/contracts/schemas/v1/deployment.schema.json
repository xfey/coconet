{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.coddis.dev/v1/deployment.schema.json",
  "title": "Coconet Deployment identity handshake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "deployment_id",
    "server_version",
    "public_key",
    "public_key_sha256",
    "challenge",
    "signature",
    "capabilities",
    "capabilities_signature"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "protocol_version": { "type": "integer", "const": 1 },
    "deployment_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "server_version": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "public_key": { "type": "string", "minLength": 43, "maxLength": 44 },
    "public_key_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "challenge": { "type": "string", "minLength": 16, "maxLength": 128 },
    "signature": { "type": "string", "minLength": 86, "maxLength": 88 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
    },
    "capabilities_signature": { "type": "string", "minLength": 86, "maxLength": 88 }
  }
}
