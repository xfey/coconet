{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.coddis.dev/v1/workspaces.schema.json",
  "title": "Confirmed local directory snapshots",
  "$defs": {
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\u0000-\u001f\u007f]*$"
        },
        "connected_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "project_id",
        "path",
        "connected_at"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "installation_id": {
          "type": "string",
          "pattern": "^workspace_[a-f0-9]{32}$"
        },
        "device_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "folders": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/folder"
          }
        }
      },
      "required": [
        "schema_version",
        "installation_id",
        "device_name",
        "revision",
        "folders"
      ]
    },
    "report_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "status",
        "revision"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "device_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "connected_at": {
          "type": "string",
          "format": "date-time"
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "account_id",
        "display_name",
        "device_name",
        "path",
        "connected_at",
        "reported_at"
      ]
    },
    "list_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "folders": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "status",
        "folders"
      ]
    }
  }
}
